{
    "name": "nicolasrz/article-invoice-legacy",
    "description": "Le code de départ de l'article sur les tests dans un projet existant",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "doctrine/orm": "^3.0",
        "psr/log": "^3.0",
        "symfony/http-client": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/cache": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
